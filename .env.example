# Data Quality - DQ_* environment contract
# =====================================================
# This file documents the ONLY environment variables read by the code.
# It is an example template: every value here is a placeholder default.
# Precedence: dataclass defaults < configs/quality.yaml < DQ_* environment
# variables. Threshold fields have NO DQ_* environment override (see
# PlatformConfig.from_yaml docstring in data_quality_platform/config/settings.py).
#
# Copy to .env (gitignored) and fill in per environment. Never commit real
# credentials.

# --- ClickHouse (data_quality_platform/config/settings.py) ---
DQ_CLICKHOUSE_HOST=localhost
DQ_CLICKHOUSE_PORT=8123
DQ_CLICKHOUSE_USER=default
DQ_CLICKHOUSE_PASSWORD=

# --- Alerting (data_quality_platform/config/settings.py) ---
DQ_SLACK_WEBHOOK_URL=

# --- SMTP alerting (data_quality_platform/config/settings.py) ---
DQ_SMTP_HOST=
DQ_SMTP_PORT=587
DQ_SMTP_USER=
DQ_SMTP_PASSWORD=

# --- Identity context (data_quality_platform/security/auth.py AuthContext) ---
# Optional; anonymous/viewer when unset.
#DQ_USER_ID=
#DQ_USER_ROLES=viewer

# --- SecretsManager pattern (data_quality_platform/security/auth.py) ---
# SecretsManager.get_secret(key) reads DQ_SECRET_<KEY> at runtime;
# SecretsManager.get_config(key) reads DQ_CONFIG_<KEY>.
# No DQ_SECRET_* / DQ_CONFIG_* variable is required by the execution path.
